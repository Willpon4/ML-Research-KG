<http://example.org/mlkg/data/publication/arxiv_2501_03575> a mlkg:Publication ;
    rdfs:label "Cosmos World Foundation Model Platform for Physical AI" ;
    mlkg:abstract "Physical AI needs to be trained digitally first. It needs a digital twin of itself, the policy model, and a digital twin of the world, the world model. In this paper, we present the Cosmos World Foundation Model Platform to help developers build customized world models for their Physical AI setups. We position a world foundation model as a general-purpose world model that can be fine-tuned into customized world models for downstream applications. Our platform covers a video curation pipeline, pre-trained world foundation models, examples of post-training of pre-trained world foundation models, and video tokenizers. To help Physical AI builders solve the most critical problems of our society, we make Cosmos open-source and our models open-weight with permissive licenses available via https://github.com/nvidia-cosmos/cosmos-predict1."^^xsd:string ;
    mlkg:citationCount 0 ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/arxiv_author_nvidia> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/transfer_learning> ;
    mlkg:inArea <http://example.org/mlkg/data/area/artificial_intelligence>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/cs_ro>,
        <http://example.org/mlkg/data/area/machine_learning>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2025 ;

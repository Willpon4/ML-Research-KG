    mlkg:hasKeyword <http://example.org/mlkg/data/topic/cnn>,
        <http://example.org/mlkg/data/topic/gnn> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/deep_learning>,
        <http://example.org/mlkg/data/area/graph_ml> ;
    mlkg:publicationYear 2017 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/iclr> ;
    mlkg:title "Semi-Supervised Classification with Graph Convolutional Networks"^^xsd:string .

<http://example.org/mlkg/data/publication/p007> a mlkg:Publication ;
    rdfs:label "Graph Attention Networks" ;
    mlkg:abstract "We present graph attention networks (GATs), novel neural network architectures that operate on graph-structured data, leveraging masked self-attentional layers to address the shortcomings of prior methods based on graph convolutions."^^xsd:string ;
    mlkg:citationCount 18000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,
        <http://example.org/mlkg/data/publication/p002>,
        <http://example.org/mlkg/data/publication/p006> ;

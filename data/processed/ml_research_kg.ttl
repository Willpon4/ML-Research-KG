<http://example.org/mlkg/data/publication/p005> a mlkg:Publication ;
    rdfs:label "A Style-Based Generator Architecture for Generative Adversarial Networks" ;
    mlkg:abstract "We propose an alternative generator architecture for generative adversarial networks, borrowing from style transfer literature. The new architecture leads to an automatically learned, unsupervised separation of high-level attributes."^^xsd:string ;
    mlkg:citationCount 12000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,
        <http://example.org/mlkg/data/publication/p004>,
        <http://example.org/mlkg/data/publication/p011> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a015> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/gan> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/generative_models> ;
    mlkg:publicationYear 2019 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/cvpr> ;
    mlkg:title "A Style-Based Generator Architecture for Generative Adversarial Networks"^^xsd:string .

<http://example.org/mlkg/data/publication/p006> a mlkg:Publication ;
    rdfs:label "Semi-Supervised Classification with Graph Convolutional Networks" ;
    mlkg:abstract "We present a scalable approach for semi-supervised learning on graph-structured data that is based on an efficient variant of convolutional neural networks which operate directly on graphs."^^xsd:string ;
    mlkg:citationCount 25000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,
        <http://example.org/mlkg/data/publication/p032>,
        <http://example.org/mlkg/data/publication/p033> ;

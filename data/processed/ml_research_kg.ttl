<http://example.org/mlkg/data/publication/p033> a mlkg:Publication ;
    rdfs:label "Adam: A Method for Stochastic Optimization" ;
    mlkg:abstract "We introduce Adam, an algorithm for first-order gradient-based optimization of stochastic objective functions, based on adaptive estimates of lower-order moments."^^xsd:string ;

<http://example.org/mlkg/data/publication/p003> a mlkg:Publication ;
    rdfs:label "Language Models are Few-Shot Learners" ;
    mlkg:abstract "Recent work has demonstrated substantial gains on many NLP tasks and benchmarks by pre-training on a large corpus of text followed by fine-tuning on a specific task. We show that scaling up language models greatly improves task-agnostic, few-shot performance."^^xsd:string ;

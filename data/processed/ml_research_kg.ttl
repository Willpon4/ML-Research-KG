    mlkg:publicationYear 2017 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/arxiv> ;
    mlkg:title "Proximal Policy Optimization Algorithms"^^xsd:string .

<http://example.org/mlkg/data/publication/p022> a mlkg:Publication ;
    rdfs:label "A Simple Framework for Contrastive Learning of Visual Representations" ;
    mlkg:abstract "This paper presents SimCLR: a simple framework for contrastive learning of visual representations. We simplify recently proposed contrastive self-supervised learning algorithms without requiring specialized architectures."^^xsd:string ;
    mlkg:citationCount 14000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p011>,
        <http://example.org/mlkg/data/publication/p030> ;

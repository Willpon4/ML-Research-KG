<http://example.org/mlkg/data/publication/p002> a mlkg:Publication ;
    rdfs:label "BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding" ;
    mlkg:abstract "We introduce a new language representation model called BERT, which stands for Bidirectional Encoder Representations from Transformers. BERT is designed to pre-train deep bidirectional representations from unlabeled text by jointly conditioning on both left and right context."^^xsd:string ;

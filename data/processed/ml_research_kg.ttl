<http://example.org/mlkg/data/publication/p016> a mlkg:Publication ;
    rdfs:label "Translating Embeddings for Modeling Multi-relational Data" ;
    mlkg:abstract "We consider the problem of embedding entities and relationships of multi-relational data in low-dimensional vector spaces. Our model, TransE, learns vector embeddings so that relationships correspond to translations in the embedding space."^^xsd:string ;
    mlkg:citationCount 8500 ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a042> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/natural_language_processing>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2013 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "Translating Embeddings for Modeling Multi-relational Data"^^xsd:string .

<http://example.org/mlkg/data/publication/p019> a mlkg:Publication ;
    rdfs:label "Playing Atari with Deep Reinforcement Learning" ;
    mlkg:abstract "We present the first deep learning model to successfully learn control policies directly from high-dimensional sensory input using reinforcement learning. We use a deep Q-network (DQN) to learn to play Atari 2600 games."^^xsd:string ;
    mlkg:citationCount 15000 ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a049> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/rl_deep> ;

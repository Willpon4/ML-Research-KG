@prefix mlkg: <http://example.org/mlkg/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mlkg: a owl:Ontology ;
    rdfs:label "Machine Learning Research Knowledge Graph Ontology" ;
    rdfs:comment "Ontology for representing ML research papers, authors, institutions, and their relationships." .

mlkg:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:comment "The abstract text of a publication." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range xsd:string .

mlkg:affiliatedWith a owl:ObjectProperty ;
    rdfs:label "affiliated with" ;
    rdfs:comment "Connects an author to their institution." ;
    rdfs:domain mlkg:Author ;
    rdfs:range mlkg:Institution .

mlkg:authorOf a owl:ObjectProperty ;
    rdfs:label "author of" ;
    rdfs:comment "Connects an author to a paper they wrote." ;
    rdfs:domain mlkg:Author ;
    rdfs:range mlkg:Publication .

mlkg:citationCount a owl:DatatypeProperty ;
    rdfs:label "citation count" ;
    rdfs:comment "The number of times a paper has been cited." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range xsd:integer .

mlkg:cites a owl:ObjectProperty ;
    rdfs:label "cites" ;
    rdfs:comment "Indicates that one paper cites another." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:Publication .

mlkg:coauthorWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "coauthor with" ;
    rdfs:comment "Connects two authors who have co-authored a paper." ;
    rdfs:domain mlkg:Author ;
    rdfs:range mlkg:Author .

mlkg:firstAuthor a owl:ObjectProperty ;
    rdfs:label "first author" ;
    rdfs:comment "Identifies the first/lead author of a publication." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:Author .

mlkg:hasCode a owl:ObjectProperty ;
    rdfs:label "has code" ;
    rdfs:comment "Connects a paper to its code implementation." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:CodeRepository .

mlkg:hasKeyword a owl:ObjectProperty ;
    rdfs:label "has keyword" ;
    rdfs:comment "Connects a paper to a specific research topic." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:ResearchTopic .

mlkg:implementationOf a owl:ObjectProperty ;
    rdfs:label "implementation of" ;
    rdfs:comment "Connects a code repo to the paper it implements." ;
    rdfs:domain mlkg:CodeRepository ;
    rdfs:range mlkg:Publication .

mlkg:inArea a owl:ObjectProperty ;
    rdfs:label "in area" ;
    rdfs:comment "Connects a paper to a broad research area." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:ResearchArea .

mlkg:publicationYear a owl:DatatypeProperty ;
    rdfs:label "publication year" ;
    rdfs:comment "The year a paper was published." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range xsd:integer .

mlkg:publishedIn a owl:ObjectProperty ;
    rdfs:label "published in" ;
    rdfs:comment "Connects a paper to the venue where it was published." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:Venue .

mlkg:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "The title of a publication." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range xsd:string .

mlkg:topicInArea a owl:ObjectProperty ;
    rdfs:label "topic in area" ;
    rdfs:comment "Connects a specific topic to its broader research area." ;
    rdfs:domain mlkg:ResearchTopic ;
    rdfs:range mlkg:ResearchArea .

mlkg:usesDataset a owl:ObjectProperty ;
    rdfs:label "uses dataset" ;
    rdfs:comment "Connects a paper to a dataset it uses." ;
    rdfs:domain mlkg:Publication ;
    rdfs:range mlkg:Dataset .

mlkg:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:comment "A dataset used for training or evaluation." .


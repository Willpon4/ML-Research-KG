<http://example.org/mlkg/data/publication/p015> a mlkg:Publication ;
    rdfs:label "Photorealistic Text-to-Image Diffusion Models with Deep Language Understanding" ;
    mlkg:abstract "We present Imagen, a text-to-image diffusion model with an unprecedented degree of photorealism and a deep level of language understanding. Imagen builds on the power of large transformer language models."^^xsd:string ;
    mlkg:citationCount 5000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,
        <http://example.org/mlkg/data/publication/p003>,
        <http://example.org/mlkg/data/publication/p013>,
        <http://example.org/mlkg/data/publication/p014> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a041> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/diffusion>,
        <http://example.org/mlkg/data/topic/transformer> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/deep_learning>,
        <http://example.org/mlkg/data/area/generative_models>,
        <http://example.org/mlkg/data/area/natural_language_processing> ;
    mlkg:publicationYear 2022 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "Photorealistic Text-to-Image Diffusion Models with Deep Language Understanding"^^xsd:string .

<http://example.org/mlkg/data/publication/p018> a mlkg:Publication ;
    rdfs:label "Complex Embeddings for Simple Link Prediction" ;
    mlkg:abstract "In statistical relational learning, knowledge graph completion deals with automatically understanding the structure of large knowledge graphs. We present ComplEx, an extension of DistMult that uses complex-valued embeddings for link prediction."^^xsd:string ;
    mlkg:citationCount 3000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p016>,
        <http://example.org/mlkg/data/publication/p017> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a047> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/knowledge_graph> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/graph_ml>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2016 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/icml> ;
    mlkg:title "Complex Embeddings for Simple Link Prediction"^^xsd:string .

<http://example.org/mlkg/data/publication/p023> a mlkg:Publication ;
    rdfs:label "Momentum Contrast for Unsupervised Visual Representation Learning" ;
    mlkg:abstract "We present Momentum Contrast (MoCo) for unsupervised visual representation learning. We view contrastive learning as dictionary look-up, and build a dynamic dictionary with a queue and a moving-averaged encoder."^^xsd:string ;
    mlkg:citationCount 12000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p011>,
        <http://example.org/mlkg/data/publication/p022> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a028> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/self_supervised> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2020 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/cvpr> ;
    mlkg:title "Momentum Contrast for Unsupervised Visual Representation Learning"^^xsd:string .

<http://example.org/mlkg/data/publication/p025> a mlkg:Publication ;
    rdfs:label "Advances and Open Problems in Federated Learning" ;
    mlkg:abstract "Federated learning is a machine learning setting where multiple entities collaborate in solving a machine learning problem under the coordination of a central server. This paper discusses recent advances and enumerates important open problems."^^xsd:string ;
    mlkg:citationCount 6000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p024> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a060> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/federated_learning> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/optimization> ;
    mlkg:publicationYear 2021 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/foundations_and_trends_in_ml> ;
    mlkg:title "Advances and Open Problems in Federated Learning"^^xsd:string .

<http://example.org/mlkg/data/publication/p027> a mlkg:Publication ;
    rdfs:label "DARTS: Differentiable Architecture Search" ;
    mlkg:abstract "We address the scalability challenge of neural architecture search by formulating the task in a differentiable manner. We propose DARTS, an efficient architecture search algorithm that uses continuous relaxation of the discrete search space."^^xsd:string ;
    mlkg:citationCount 5500 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p008>,
        <http://example.org/mlkg/data/publication/p026> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a065> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/neural_arch_search> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/optimization> ;
    mlkg:publicationYear 2019 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/iclr> ;
    mlkg:title "DARTS: Differentiable Architecture Search"^^xsd:string .

<http://example.org/mlkg/data/publication/p035> a mlkg:Publication ;
    rdfs:label "Constitutional AI: Harmlessness from AI Feedback" ;
    mlkg:abstract "We experiment with methods for training a harmless AI assistant through a process we call Constitutional AI. The approach involves both a supervised learning and a reinforcement learning phase using AI-generated feedback."^^xsd:string ;
    mlkg:citationCount 2000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p003>,
        <http://example.org/mlkg/data/publication/p010>,
        <http://example.org/mlkg/data/publication/p031> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a080> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/reinforcement_learning> ;
    mlkg:publicationYear 2022 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/arxiv> ;
    mlkg:title "Constitutional AI: Harmlessness from AI Feedback"^^xsd:string .


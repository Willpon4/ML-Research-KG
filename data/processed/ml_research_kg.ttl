<http://example.org/mlkg/data/publication/p011> a mlkg:Publication ;
    rdfs:label "Deep Residual Learning for Image Recognition" ;
    mlkg:abstract "Deeper neural networks are more difficult to train. We present a residual learning framework to ease the training of networks that are substantially deeper than those used previously. We explicitly reformulate the layers as learning residual functions."^^xsd:string ;
    mlkg:citationCount 165000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p009>,

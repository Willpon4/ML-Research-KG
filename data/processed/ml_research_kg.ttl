<http://example.org/mlkg/data/publication/p004> a mlkg:Publication ;
    rdfs:label "Generative Adversarial Nets" ;
    mlkg:abstract "We propose a new framework for estimating generative models via an adversarial process, in which we simultaneously train two models: a generative model G that captures the data distribution, and a discriminative model D that estimates the probability."^^xsd:string ;
    mlkg:citationCount 55000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,

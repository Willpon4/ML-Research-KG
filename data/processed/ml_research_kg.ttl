    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2020 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/icml> ;
    mlkg:title "A Simple Framework for Contrastive Learning of Visual Representations"^^xsd:string .

<http://example.org/mlkg/data/publication/p028> a mlkg:Publication ;
    rdfs:label "You Only Look Once: Unified, Real-Time Object Detection" ;
    mlkg:abstract "We present YOLO, a new approach to object detection. We frame object detection as a regression problem to spatially separated bounding boxes and associated class probabilities."^^xsd:string ;
    mlkg:citationCount 38000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p012>,
        <http://example.org/mlkg/data/publication/p029> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a067> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/object_detection> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision> ;
    mlkg:publicationYear 2016 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/cvpr> ;
    mlkg:title "You Only Look Once: Unified, Real-Time Object Detection"^^xsd:string .

<http://example.org/mlkg/data/publication/p032> a mlkg:Publication ;
    rdfs:label "Dropout: A Simple Way to Prevent Neural Networks from Overfitting" ;
    mlkg:abstract "Deep neural nets with a large number of parameters are very powerful machine learning systems. However, overfitting is a serious problem. We propose dropout, a technique for addressing this problem by randomly dropping units during training."^^xsd:string ;
    mlkg:citationCount 38000 ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a075> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/deep_learning>,
        <http://example.org/mlkg/data/area/optimization> ;
    mlkg:publicationYear 2014 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/jmlr> ;
    mlkg:title "Dropout: A Simple Way to Prevent Neural Networks from Overfitting"^^xsd:string .


<http://example.org/mlkg/data/publication/p008> a mlkg:Publication ;
    rdfs:label "Inductive Representation Learning on Large Graphs" ;
    mlkg:abstract "Low-dimensional embeddings of nodes in large graphs have proved extremely useful in a variety of prediction tasks. We propose GraphSAGE, a general inductive framework that leverages node feature information to efficiently generate node embeddings."^^xsd:string ;
    mlkg:citationCount 15000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p006>,
        <http://example.org/mlkg/data/publication/p007> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a022> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/gnn> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/graph_ml>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2017 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "Inductive Representation Learning on Large Graphs"^^xsd:string .

<http://example.org/mlkg/data/publication/p014> a mlkg:Publication ;
    rdfs:label "High-Resolution Image Synthesis with Latent Diffusion Models" ;
    mlkg:abstract "By decomposing the image formation process into a sequential application of denoising autoencoders, diffusion models achieve state-of-the-art synthesis results. We apply diffusion models in the latent space of powerful pretrained autoencoders."^^xsd:string ;
    mlkg:citationCount 9000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p004>,
        <http://example.org/mlkg/data/publication/p013> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a038> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/diffusion>,
        <http://example.org/mlkg/data/topic/transfer_learning> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/generative_models>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2022 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/cvpr> ;
    mlkg:title "High-Resolution Image Synthesis with Latent Diffusion Models"^^xsd:string .

<http://example.org/mlkg/data/publication/p017> a mlkg:Publication ;
    rdfs:label "RotatE: Knowledge Graph Embedding by Relational Rotation in Complex Space" ;
    mlkg:abstract "We study the problem of learning representations of entities and relations in knowledge graphs. We propose RotatE, which defines each relation as a rotation from the source entity to the target entity in the complex vector space."^^xsd:string ;
    mlkg:citationCount 3200 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p016> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a045> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/knowledge_graph> ;

<http://example.org/mlkg/data/author/arxiv_author_daiki_kimura> a mlkg:Author ;
    rdfs:label "Daiki Kimura" ;
    mlkg:authorOf <http://example.org/mlkg/data/publication/arxiv_2310_18660> ;

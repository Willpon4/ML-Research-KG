<http://example.org/mlkg/data/publication/p009> a mlkg:Publication ;
    rdfs:label "An Image is Worth 16x16 Words: Transformers for Image Recognition at Scale" ;
    mlkg:abstract "While the Transformer architecture has become the de-facto standard for natural language processing tasks, its applications to computer vision remain limited. We show that a pure transformer applied directly to sequences of image patches can perform very well on image classification tasks."^^xsd:string ;
    mlkg:citationCount 30000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,
        <http://example.org/mlkg/data/publication/p011> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a025> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/transformer> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/deep_learning>,
        <http://example.org/mlkg/data/area/natural_language_processing> ;
    mlkg:publicationYear 2021 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/iclr> ;
    mlkg:title "An Image is Worth 16x16 Words: Transformers for Image Recognition at Scale"^^xsd:string .

<http://example.org/mlkg/data/publication/p010> a mlkg:Publication ;
    rdfs:label "Training language models to follow instructions with human feedback" ;
    mlkg:abstract "Making language models bigger does not inherently make them better at following a user's intent. We show that fine-tuning with human feedback significantly improves language model behavior through reinforcement learning from human feedback (RLHF)."^^xsd:string ;
    mlkg:citationCount 8500 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p001>,
        <http://example.org/mlkg/data/publication/p002>,
        <http://example.org/mlkg/data/publication/p003>,
        <http://example.org/mlkg/data/publication/p021> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a026> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/gpt>,
        <http://example.org/mlkg/data/topic/transfer_learning> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/natural_language_processing>,
        <http://example.org/mlkg/data/area/reinforcement_learning>,
        <http://example.org/mlkg/data/area/representation_learning> ;
    mlkg:publicationYear 2022 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "Training language models to follow instructions with human feedback"^^xsd:string .

<http://example.org/mlkg/data/publication/p020> a mlkg:Publication ;
    rdfs:label "Conditional Image Generation with PixelCNN Decoders" ;
    mlkg:abstract "This work explores conditional image generation with a new image density model based on the PixelCNN architecture. We show that a single model can generate diverse, globally coherent images."^^xsd:string ;
    mlkg:citationCount 4500 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p004>,
        <http://example.org/mlkg/data/publication/p005> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a052> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/cnn> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/generative_models> ;
    mlkg:publicationYear 2016 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "Conditional Image Generation with PixelCNN Decoders"^^xsd:string .

<http://example.org/mlkg/data/publication/p024> a mlkg:Publication ;
    rdfs:label "Communication-Efficient Learning of Deep Networks from Decentralized Data" ;
    mlkg:abstract "Modern mobile devices have access to a wealth of data suitable for learning models, which in turn can greatly improve the user experience on the device. We propose federated learning, a method for training deep networks on decentralized data."^^xsd:string ;
    mlkg:citationCount 18000 ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a060> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/federated_learning> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision>,
        <http://example.org/mlkg/data/area/optimization> ;

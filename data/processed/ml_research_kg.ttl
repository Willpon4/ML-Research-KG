        <http://example.org/mlkg/data/area/deep_learning>,
        <http://example.org/mlkg/data/area/reinforcement_learning> ;
    mlkg:publicationYear 2013 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/nips_workshop> ;
    mlkg:title "Playing Atari with Deep Reinforcement Learning"^^xsd:string .

<http://example.org/mlkg/data/publication/p029> a mlkg:Publication ;
    rdfs:label "Faster R-CNN: Towards Real-Time Object Detection with Region Proposal Networks" ;
    mlkg:abstract "State-of-the-art object detection networks depend on region proposal algorithms. We introduce a Region Proposal Network that shares full-image convolutional features with the detection network, enabling nearly cost-free region proposals."^^xsd:string ;
    mlkg:citationCount 45000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p012>,
        <http://example.org/mlkg/data/publication/p028> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a030> ;
    mlkg:hasKeyword <http://example.org/mlkg/data/topic/cnn>,
        <http://example.org/mlkg/data/topic/object_detection> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,
        <http://example.org/mlkg/data/area/computer_vision> ;
    mlkg:publicationYear 2015 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "Faster R-CNN: Towards Real-Time Object Detection with Region Proposal Networks"^^xsd:string .

<http://example.org/mlkg/data/publication/p030> a mlkg:Publication ;
    rdfs:label "How transferable are features in deep neural networks?" ;
    mlkg:abstract "Many deep neural networks trained on natural images exhibit a curious phenomenon in common: on the first layer they learn features similar to Gabor filters and color blobs. We study the transferability of features learned at different layers."^^xsd:string ;
    mlkg:citationCount 12000 ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a071> ;
    mlkg:inArea <http://example.org/mlkg/data/area/computer_science>,

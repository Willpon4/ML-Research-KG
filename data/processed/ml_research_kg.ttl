        <http://example.org/mlkg/data/area/deep_learning> ;
    mlkg:publicationYear 2014 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/neurips> ;
    mlkg:title "How transferable are features in deep neural networks?"^^xsd:string .


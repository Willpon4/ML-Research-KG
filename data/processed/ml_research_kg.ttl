    mlkg:publicationYear 2019 ;
    mlkg:publishedIn <http://example.org/mlkg/data/venue/iclr> ;
    mlkg:title "RotatE: Knowledge Graph Embedding by Relational Rotation in Complex Space"^^xsd:string .

<http://example.org/mlkg/data/publication/p021> a mlkg:Publication ;
    rdfs:label "Proximal Policy Optimization Algorithms" ;
    mlkg:abstract "We propose a new family of policy gradient methods for reinforcement learning, which alternate between sampling data through interaction with the environment, and optimizing a surrogate objective function using stochastic gradient ascent."^^xsd:string ;
    mlkg:citationCount 14000 ;
    mlkg:cites <http://example.org/mlkg/data/publication/p019> ;
    mlkg:firstAuthor <http://example.org/mlkg/data/author/a054> ;
